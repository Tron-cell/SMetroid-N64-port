--- a/src/device/r4300/r4300_core.c
+++ b/src/device/r4300/r4300_core.c
@@ -20,6 +20,7 @@
  * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
 
 #include "r4300_core.h"
+#include "device/rcp/mi/mi_controller.h"
 #include "cached_interp.h"
 #if defined(COUNT_INSTR)
 #include "instr_counters.h"
@@ -399,6 +400,19 @@ int r4300_write_aligned_dword(struct r4300_core* r4300, uint32_t address, uint64
     address &= UINT32_C(0x1ffffffc);
 
     const struct mem_handler* handler = mem_get_handler(r4300->mem, address);
+    /* MI repeat mode: the next RDRAM write repeats the value over len bytes */
+    if ((r4300->mi->regs[MI_INIT_MODE_REG] & 0x80) && address < 0x03f00000) {
+        unsigned len = (r4300->mi->regs[MI_INIT_MODE_REG] & 0x7f) + 1;
+        for (unsigned i = 0; i < len; i += 4) {
+            uint32_t w = (i & 4) ? (uint32_t)value : (uint32_t)(value >> 32);
+            uint32_t m = len - i >= 4 ? ~UINT32_C(0) : ~UINT32_C(0) << (8 * (4 - (len - i)));
+            mem_write32(handler, address + i, w, m);
+        }
+        invalidate_r4300_cached_code(r4300, address | 0x80000000, len);
+        invalidate_r4300_cached_code(r4300, address | 0xa0000000, len);
+        r4300->mi->regs[MI_INIT_MODE_REG] &= ~0x80;
+        return 1;
+    }
     mem_write32(handler, address + 0, value >> 32,      mask >> 32);
     mem_write32(handler, address + 4, (uint32_t) value, (uint32_t) mask      );
 
