+  constexpr auto operator-() const { return -(T)*this; }
+  LeInt &operator++() { set((T)((T)*this + 1)); return *this; }
+  LeInt &operator--() { set((T)((T)*this - 1)); return *this; }
+  T operator++(int) { T old = *this; set((T)(old + 1)); return old; }
+  T operator--(int) { T old = *this; set((T)(old - 1)); return old; }
